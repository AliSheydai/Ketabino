@@ -0,0 +1,17 @@
+'use client';
+
+import type { ReactNode } from 'react';
+import { ThemeProvider } from 'next-themes';
+
+export function NextThemeProvider({ children }: { children: ReactNode }) {
+  return (
+    <ThemeProvider
+      attribute="data-theme"
+      defaultTheme="dark"
+      enableSystem={false}
+      disableTransitionOnChange
+    >
+      {children}
+    </ThemeProvider>
+  );
+}
